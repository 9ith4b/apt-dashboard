POSTGRES_DB=apt_hunter
POSTGRES_USER=apt_hunter
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=apt_hunter
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
WEB_PORT=8180
MINIO_CONSOLE_PORT=9101
WORKER_CONCURRENCY=1
PROMETHEUS_PORT=9090
# Set to a Git commit SHA or release version in production.
APT_HUNTER_IMAGE_TAG=dev
# Override these with registry paths when deploying published images.
APT_HUNTER_API_IMAGE=apt-hunter-api
APT_HUNTER_WEB_IMAGE=apt-hunter-web
# Optional official API credentials. Leave empty until the corresponding source is configured.
APT_HUNTER_X_BEARER_TOKEN=
APT_HUNTER_TELEGRAM_BOT_TOKEN=
# Keep false only for a trusted HTTP-only development network. Use true behind HTTPS.
APT_HUNTER_AUTH_ENABLED=true
APT_HUNTER_SESSION_SECURE_COOKIE=false
APT_HUNTER_SESSION_TTL_HOURS=12
